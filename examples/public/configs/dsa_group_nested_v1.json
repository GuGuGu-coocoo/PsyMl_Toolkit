{
  "schema_version": "1.0",
  "task": "classification",
  "target_column": "activity",
  "model_name": "dummy",
  "input_path": "examples/public/data/dsa_torso_mean_std.csv",
  "output_dir": "examples/public/results/dsa_group_nested_v1",
  "group_column": "subject_id",
  "feature_columns": [
    "torso_acc_x_mean",
