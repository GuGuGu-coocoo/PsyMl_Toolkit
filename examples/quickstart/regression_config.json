{
  "schema_version": "1.0",
  "task": "regression",
  "target_column": "target",
  "model_name": "ridge",
  "input_path": "regression_train.csv",
  "output_dir": "results/quickstart_regression",
  "feature_columns": [
    "score",
    "category"
  ],
  "group_column": "participant",
  "validation_strategy": "group_k_fold",
  "n_splits": 3,
  "random_seed": 42,
  "tuning_mode": "quick",
  "inner_splits": 3,
  "max_candidates": 12,
  "figure_types": [
    "observed_vs_predicted",
    "residuals",
    "residual_distribution"
  ],
  "save_best_model": true,
  "primary_validation": "group_k_fold"
}
