{
  "schema_version": "1.0",
  "task": "classification",
  "target_column": "target",
  "model_name": "logistic_regression",
  "input_path": "classification_train.csv",
  "output_dir": "results/quickstart_classification_coefficients",
  "feature_columns": [
    "score",
    "category"
  ],
  "group_column": "participant",
  "validation_strategy": "group_k_fold",
  "n_splits": 3,
  "random_seed": 42,
  "tuning_mode": "none",
  "figure_types": [
    "confusion_matrix",
    "class_distribution"
  ],
  "save_best_model": true,
  "primary_validation": "group_k_fold"
}
