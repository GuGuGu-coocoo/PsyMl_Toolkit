{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psyml.dev/schemas/event-1.0.json",
  "title": "PsyML subprocess event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event", "progress"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event": {"enum": ["started", "progress", "completed", "failed", "cancelled"]},
    "progress": {"type": "number", "minimum": 0, "maximum": 1},
    "result_path": {"type": "string"},
    "phase": {"type": "string"},
    "message": {"type": "string"},
    "completed_tasks": {"type": "integer", "minimum": 0},
    "total_tasks": {"type": "integer", "minimum": 1},
    "remaining_tasks": {"type": "integer", "minimum": 0},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "estimated_remaining_seconds": {"type": ["number", "null"], "minimum": 0},
    "current_model": {"type": "string"},
    "current_validation": {"type": "string"},
    "current_fold": {"type": "integer", "minimum": 1},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "type", "message"],
      "properties": {
        "code": {"type": "string"},
        "type": {"type": "string"},
        "message": {"type": "string"}
      }
    }
  }
}
